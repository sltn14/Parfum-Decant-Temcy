# Hanya NAMA variabel. Salin ke .env lalu isi nilainya. Jangan commit .env.
# Server
PORT=
NODE_ENV=
CLIENT_URL=
API_URL=
TRUST_PROXY=
# Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME_TEST=
# Autentikasi
JWT_SECRET=
JWT_EXPIRES_IN=
SESSION_SECRET=
# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=
# Ongkir
RAJAONGKIR_KEY=
# RajaOngkir V2 (Komerce). Key = "Shipping Cost APIKEY" dari collaborator.komerce.id. Kosong = mode mock (tanpa kuota).
# ID lokasi asal toko dari pencarian destinasi (GET /api/shipping/destinations?search=<kecamatan toko>). Wajib bila key diisi.
RAJAONGKIR_ORIGIN_ID=
# Email (bisa juga diatur sysadmin lewat Konfigurasi di aplikasi)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Gemini dan Google OAuth (opsional: bisa diatur sysadmin lewat Konfigurasi di aplikasi)
GEMINI_API_KEY=
# Opsional: pengaturan Gemini (nilai di komentar = default)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite,gemini-3.5-flash   (dipisah koma; dipakai bila model utama sibuk/timeout)
# GEMINI_API_MODE=generate                  ('generate' atau 'interactions')
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_THINKING_LEVEL=medium              (hanya mode interactions)
# GEMINI_TIMEOUT_MS=12000                   (per percobaan)
# GEMINI_RETRIES=1                          (ulang 1x pada model yang sama untuk error 5xx; 0 = mati)
# GEMINI_RETRY_DELAY_MS=800
# GEMINI_SEARCH=false                       (true = chatbot pelanggan boleh pakai Google Search; ada biaya per pencarian)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dibaca docker compose untuk build frontend
VITE_API_URL=
VITE_MIDTRANS_CLIENT_KEY=

# Cadangan AI (opsional): dipakai untuk pelanggan bila semua model Gemini gagal. Kosong = nonaktif.
# Simpan key hanya di sini atau di konfigurasi SysAdmin, jangan di kode/frontend.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile        (ganti bila model ini tidak tersedia di akunmu)
# GROQ_TIMEOUT_MS=15000

# Chatbot tim AI (opsional): bila URL dan key terisi, chatbot pelanggan memakainya (Gemini jadi cadangan).
# URL tanpa garis miring di akhir, mis. http://alamat-server:8000. Key hanya di sini atau konfigurasi SysAdmin.
# CHATBOT_API_URL=
# (nama alternatif milik tim mobile juga diterima: AI_ENDPOINT_URL=http://alamat:8000/api/chat dan AI_API_KEY)
# CHATBOT_API_KEY=
# CHATBOT_API_TIMEOUT_MS=15000
